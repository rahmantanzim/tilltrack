# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env. Only this example file is committed.

# Log detail: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Port for the local database on your computer.
# Change it if 5432 is already used (for example, by another PostgreSQL).
POSTGRES_PORT=5432

# Local database started with `npm run db:up` (see docker-compose.yml).
# The port here must match POSTGRES_PORT.
DATABASE_URL=postgres://tilltrack:tilltrack@localhost:5432/tilltrack