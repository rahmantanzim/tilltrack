# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env. Only this example file is committed.

# Log detail: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Local database started with `npm run db:up` (see docker-compose.yml).
DATABASE_URL=postgres://tilltrack:tilltrack@localhost:5432/tilltrack