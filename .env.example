# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env. Only this example file is committed.

# Log detail: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Port for the local database on your computer.
# Change it if 5432 is already used (for example, by another PostgreSQL).
# If you change it, change the port in every URL below too.
POSTGRES_PORT=5432

# --- Database connections (see docs/architecture.md, section 8) ---
# Three roles, each with only the access it needs.

# Admin (the Docker superuser). Used only by `npm run db:bootstrap` to create the other roles.
DATABASE_ADMIN_URL=postgres://tilltrack:tilltrack@localhost:5432/postgres

# Migrator: owns the tables. Used only by `npm run db:migrate`.
DATABASE_MIGRATOR_URL=postgres://tilltrack_migrator:migrator_dev_password@localhost:5432/tilltrack

# App: what the running application uses. Owns nothing, always limited by row-level security.
DATABASE_URL=postgres://tilltrack_app:app_dev_password@localhost:5432/tilltrack

# Database connections per app instance (1-100).
DATABASE_POOL_MAX=10